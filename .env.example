# DealFlow360 - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to the repository.

# ─── SERVER ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── DATABASE ─────────────────────────────────────────────────────────────────
MONGODB_URI=

# ─── AUTH ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─── CLIENT ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── OPTIONAL: EMAIL (future) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── OPTIONAL: CLOUD STORAGE (future) ────────────────────────────────────────
STORAGE_BUCKET=
