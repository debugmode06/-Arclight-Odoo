# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Environment ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.user

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.tgz
.cache/
.vite/

# ─── Explicitly allow .env.example ──────────────────────────────────────────
# All .env.* files are ignored EXCEPT the example template
.env.*
!.env.example

# ─── Security: never commit secrets ──────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
credentials/
